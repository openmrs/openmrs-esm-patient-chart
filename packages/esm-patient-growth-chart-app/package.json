    "react-chartjs-2": "^5.2.0"
  },
  "peerDependencies": {
    "@openmrs/esm-framework": "10.x",
    "react": "18.x",
    "react-i18next": "16.x",
    "react-router-dom": "6.x",
    "rxjs": "6.x",
    "swr": "2.x"
  },
  "devDependencies": {
    "openmrs": "next",
    "vitest": "^4.1.2"
  }
