{
  "name": "@openmrs/esm-patient-growth-chart-app",
  "version": "12.3.4",
  "license": "MPL-2.0",
  "description": "Patient growth chart microfrontend for the OpenMRS SPA",
  "browser": "dist/openmrs-esm-patient-growth-chart-app.js",
  "main": "src/index.ts",
  "source": true,
  "scripts": {
    "start": "openmrs develop",
    "serve": "rspack serve --mode=development",
    "debug": "npm run serve",
